# Copy to .env. Never commit real values. This file is for LOCAL DEVELOPMENT (docker compose); see docs/DEPLOYMENT.md for production.
JOLAY_DB_PASSWORD=change-me
JOLAY_JWT_SECRET=generate-with-openssl-rand-base64-48
JOLAY_ADMIN_PHONE=+77000000000
JOLAY_ADMIN_PASSWORD=change-me-too
# One-time codes: WhatsApp is the primary channel; the SMS sender is the fallback. In development both are off and the code is read from the log.
JOLAY_WHATSAPP_ENABLED=false
JOLAY_WHATSAPP_PHONE_NUMBER_ID=
JOLAY_WHATSAPP_TOKEN=
JOLAY_WHATSAPP_TEMPLATE=
JOLAY_WHATSAPP_OTP_TEMPLATE=
# Payments. DEVELOPMENT ONLY: `sandbox` moves no money and lets a customer mark their own payment as paid; the prod profile refuses it.
# Use `none` (cash + wallet rides only) or a real provider anywhere that is reachable by other people.
JOLAY_PAYMENT_PROVIDER=sandbox
JOLAY_SANDBOX_WEBHOOK_SECRET=change-me
